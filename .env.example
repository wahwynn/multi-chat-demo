# Backend Environment Variables
# Copy this file to .env and fill in your values
#
# AI model providers are all OPTIONAL. Model availability depends on:
# - API keys (Anthropic, GitHub) when set
# - Running Ollama service for Ollama models

# Anthropic API Key (OPTIONAL, for Claude models)
# Get your API key from https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-api-xxxx

# GitHub API Key (OPTIONAL, for GitHub Models)
# Create a fine-grained personal access token with "models: read" scope
# See https://docs.github.com/en/rest/models/inference
# GITHUB_API_KEY=ghp_xxxx

# Ollama Base URL (OPTIONAL)
# Default: http://localhost:11434
# Only needed if using Ollama models or if Ollama is running on a different host/port
# OLLAMA_BASE_URL=http://localhost:11434

# Chat Context Window Size (OPTIONAL)
# Default: 10
# Number of recent messages to include in context when sending to AI models
# CHAT_CONTEXT_WINDOW_SIZE=10
